#!/usr/bin/env python3
"""Every 5 minutes: email the owner the moment the server heads into trouble,
and fix what can be fixed first.

WHY. On Oct 10 2026 the 145 GB disk filled (about 5:20 to 8:27 AM EDT). Free
space had fallen at a steady 3.5 GB an hour for a whole day, but disk was read
once a day, by the 7:30 AM report, and every monitor on the box (the watchdog,
the defense, the health sampler) kept its state on the same disk and went
blind with it. The database refused writes for three hours before anyone knew.

So this job never touches the disk: its own memory is in /run (RAM), it reads
only what the kernel and systemd report, and it emails through Resend's API
directly. It runs as root (systemd: permtracker-alarm.timer).

CHECKS. Each is one alarm: emailed when it starts, again every 6 hours while it
lasts (a timed job's only when a newer run has failed again: one failed daily run
sent 5 emails on Nov 22 2026), and once when it clears. A unit's email carries
the job's own failure lines from its journal and what to do; disk and memory
are printed only for their own alarms. At most 12 alarm emails an Eastern day (the
Worker's mail is free, but Resend, the fallback, shares its 100 a day with every
subscriber's mail); over the cap, what's due waits for the first run after
midnight Eastern and the journal says "not sent".

  disk        under 25 GB free, or full within 24 hours at the last two
              hours' rate (with at least an hour of readings), unless the
              page-cache cap would stop that fall with 20 GB still free. Once
              on, it clears only 5 GB (or 6 hours) past its line, so a reading
              sitting on the line can't switch it on and off every check
  disk-crit   under 10 GB free
  memory      under 500 MB available, or swap moving over 100 pages a second
              while under 2 GB of memory is available (swap that only holds
              old pages costs nothing). Once on, it clears 256 MB above its
              lines and with swap under half its rate, so a reading sitting on
              a line can't switch it on and off every check
  unit:<name> one alarm per unit: a PERM Tracker job or service, nginx,
              cloudflared or the database in systemd's "failed" state, or
              switched on but stopped after an error (a crash into systemd's
              start limit leaves a unit "inactive", which --failed never
              lists). Once on, it clears only after the unit has stayed out of
              the failed state for 45 minutes, so a job failing on every run
              (it reads "activating" while it runs) is one alarm, not an email
              a run
  sampler     the health sampler has written nothing for 30 minutes
  page-cache  the page-cache cap has not finished for 2.5 hours
  backup      the nightly backup's last success is over 30 hours old
  journal     nothing has reached the journal on disk for an hour. When the
              disk filled on Oct 10 2026, journald fell back to keeping its
              log in memory and stayed there after space came back; the
              Nov 4 reboot then erased 25 days of every service's log

WHAT IT FIXES before it emails:
  disk        starts the page-cache cap now (it switches to tight budgets
              under 20 GB free) instead of waiting up to 30 minutes
  journal     `journalctl --flush`: journald moves what it holds in memory to
              disk and writes there again
  disk-crit   deletes the route cache of every release the live slot does not
              run from (the standby's too: a rollback renders it again), which
              takes seconds where the cap's page-by-page walk takes minutes;
              then starts the cap for the live copies

WHERE EACH GOES. Every alarm is one kind in the routing list (scripts/data/alert_routes.json, read through
lib/alert_routes.py): its channel says whether it goes by phone and email, waits for the morning report, or stays on
the admin page, and its level and reminder hours come from there too. A timed job's first failed run waits for the
report (the next run usually fixes it); two failed runs in a row go by phone and email. Every alarm's start is kept a
day in this job's memory (`events`), which the health sampler copies into the server's report, so the morning report
lists what didn't go out at once. A list that can't be read sends every alarm by email and phone, as before the
list, and the email says why.

PHONE. Each alarm that goes by phone pushes to the owner's phone (ntfy, lib/phone_push.py), beside its email and never
instead of it: once when it starts and once when it clears, never a reminder. A service systemd has stopped
restarting (the site's own: the web copies, nginx, the tunnel, the databases) pushes as urgent; every other alarm as
high; a timed job pushes only once two of its runs in a row have failed, since one failure the next run fixes is
nobody's business. At most 12 pushes an Eastern day, urgent ones excepted. A push that fails is tried again next
run, never holds up the email, and the next email says how long pushes have been failing.

`--dry-run` prints what it would send and do, and changes nothing.
"""
from __future__ import annotations

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime
from zoneinfo import ZoneInfo

for _lib in ("/usr/local/lib/permtracker", str(pathlib.Path(__file__).resolve().parent.parent / "lib")):
    if _lib not in sys.path:
        sys.path.append(_lib)
try:
    import phone_push
except ImportError:  # the email still goes; main() says the push couldn't
    phone_push = None


class _NoList:
    """The routing list's stand-in when lib/alert_routes.py isn't installed: every alarm is sent, as before the list."""
    ok, problem = False, "lib/alert_routes.py isn't installed"

    def loud(self, rid: str) -> bool:
        return True

    def level(self, rid: str, default: str = "high") -> str | None:
        return default

    def remind_s(self, rid: str, default: float | None = 6 * 3600) -> float | None:
        return default


try:
    import alert_routes
    ROUTES = alert_routes.load()
except ImportError:  # the email says why
    ROUTES = _NoList()

APP = pathlib.Path(os.environ.get("PT_APP_ROOT", "/srv/permtracker"))
RUN = pathlib.Path(os.environ.get("PT_RUN_DIR", "/run/permtracker"))
STATE = RUN / "alarm.json"
CONFIG = pathlib.Path("/etc/permtracker/defend.env")      # ALERT_TO, shared with the defense
APP_ENV = APP / "app" / "env" / "production.env"         # RESEND_API_KEY
# The mail Worker on Cloudflare (workers/mail/): free mail to the owner, outside
# Resend's 100 a day. OWNER_MAIL_URL and OWNER_MAIL_KEY; Resend when unset or down.
OWNER_MAIL = pathlib.Path("/etc/permtracker/owner-mail.env")
USER_AGENT = "permtracker-alarm/1.0 (+https://permtracker.app)"  # Cloudflare 403s Python's default
GB = 1024 ** 3
ET = ZoneInfo("America/New_York")

DISK_LOW_GB = 25
DISK_CRIT_GB = 10
FULL_WITHIN_H = 24
# The cap switches to tight budgets under this much free, so a fall it will stop
# with this much left can't fill the disk.
DISK_FLOOR_GB = 20
# An alarm already on clears only this far past its lines. Oct 19 to 20 2026: the
# caches' floor sat at 24 to 25 GB against a 25 GB line, and the disk alarm
# started and cleared five times in three hours (ten emails) with 28 GB free.
DISK_CLEAR_MARGIN_GB = 5
DISK_CLEAR_MARGIN_H = 6
TREND_WINDOW_S = 2 * 3600       # the rate is read over the last two hours
TREND_MIN_S = 3600              # ... once there is at least an hour of readings
HISTORY_S = 6 * 3600            # readings kept in /run
MEM_MIN_MB = 500
SWAP_SHORT_MEM_MB = 2048
# Pages a second moved to or from swap that count as the server swapping
# (daily_monitor.py's SWAP_ACTIVE_PAGES_S). Oct 28 2026: with the database
# file locked in RAM, 2.5 to 3.6 GB of old pages sat in swap moving about 42
# a second, and the old "over 2 GB of swap" rule emailed five times in a day.
SWAP_ACTIVE_PAGES_S = 100
MEM_CLEAR_MARGIN_MB = 256
SAMPLER_STALE_S = 30 * 60
PRUNE_STALE_S = int(2.5 * 3600)
# A release whose .next/server holds this much more than the cap counted has
# pages in a folder the cap doesn't read (the cap records both figures).
UNCOUNTED_GB = 15
BACKUP_STALE_S = 30 * 3600
# The server logs every minute (timers, nginx's units, the web copies), so an hour
# with nothing written to disk means journald isn't writing there.
JOURNAL_STALE_S = 3600
JOURNAL = pathlib.Path(os.environ.get("PT_JOURNAL_DIR", "/var/log/journal"))
REMIND_S = 6 * 3600
EMAILS_PER_DAY = 12
# A job that fails on every run is "failed" between runs and "activating" while
# it runs, so an alarm keyed on the failed state started and cleared on every
# run: policy-watch's 30-minute and flag-notice's 15-minute runs sent 11 emails
# in an hour on Oct 29 2026 and then held the day's cap. A unit's alarm stays on
# until the unit has been out of the failed state this long.
UNIT_CLEAR_S = 45 * 60
# Units that are ours (or that the site cannot run without). Anything else
# systemd lists as failed (fwupd, PCP's loggers) is the OS's business.
OUR_UNITS = ("permtracker", "nginx", "cloudflared", "sqld")
PUSHES_PER_DAY = 12
# A timed job pushes once this many of its runs in a row have failed.
JOB_FAILS_TO_PUSH = 2
# What to do, in each alarm's push (a unit's is built in todo_of).
TODO = {
    "disk": "The page-cache cap was started. If free space keeps falling, follow the runbook's disk steps.",
    "disk-crit": "Old route caches were deleted and the cap started. If it stays under 10 GB, free space now.",
    "memory": "If the site is slow, restart the busiest web copy (systemctl restart permtracker-web@<slot>).",
    "sampler": "ssh permtracker, then systemctl status permtracker-health.",
    "page-cache": "ssh permtracker, then systemctl status permtracker-prune.",
    "page-cache-blind": "Read the email for the release, then raise the cap's budget or clear that release's pages.",
    "backup": "ssh permtracker, then systemctl status permtracker-backup, and run it by hand once fixed.",
    "journal": "journalctl --flush was run. If this lasts, check the disk.",
}

DRY_RUN = "--dry-run" in sys.argv


# --------------------------------------------------------------------------
# Pure parts (tested in scripts/oracle/test_alarm.py)
# --------------------------------------------------------------------------

def rate_gb_per_hour(points: list[list[float]], now: float) -> float | None:
    """Free-space change in GB an hour over the trend window; positive = filling.

    None until the window holds at least TREND_MIN_S of readings.
    """
    pts = [(t, free) for t, free in points if now - t <= TREND_WINDOW_S]
    if len(pts) < 3 or pts[-1][0] - pts[0][0] < TREND_MIN_S:
        return None
    n = len(pts)
    mt = sum(t for t, _ in pts) / n
    mf = sum(f for _, f in pts) / n
    var = sum((t - mt) ** 2 for t, _ in pts)
    if var == 0:
        return None
    slope = sum((t - mt) * (f - mf) for t, f in pts) / var   # GB per second, free
    return -slope * 3600


def swap_rate(prev: list | None, now: float, pages: int | None) -> float | None:
    """Pages a second moved to or from swap since the last reading, or None.

    None on the first run, after a reboot (the counter starts again) or across
    a gap of an hour or more.
    """
    if not prev or pages is None:
        return None
    t, before = prev
    dt = now - t
    if not 60 <= dt < 3600 or pages < before:
        return None
    return round((pages - before) / dt, 1)


def evaluate(snap: dict, rate: float | None, already_on=()) -> dict[str, str]:
    """The alarms on now, each with its one-line reason.

    `already_on` names the alarms on at the last check: the disk alarm's lines
    move out by DISK_CLEAR_MARGIN_GB and DISK_CLEAR_MARGIN_H while it is on.
    """
    on: dict[str, str] = {}
    free = snap["disk_free_gb"]
    hours = free / rate if rate and rate > 0.2 else None
    held = "disk" in already_on
    margin_gb = DISK_CLEAR_MARGIN_GB if held else 0
    within_h = FULL_WITHIN_H + (DISK_CLEAR_MARGIN_H if held else 0)
    # A fall the page-cache cap will stop isn't the disk filling: the cached
    # pages grow until their budgets and no further, so if the disk would
    # still have DISK_FLOOR_GB free with every cache at its budget, the trend
    # alone raises nothing (Oct 10 2026: the live cache refilling toward its
    # 60 GB read as "full in 12 hours" with 37 GB to spare). Unknown headroom,
    # or a cache the cap can't see, keeps the plain trend.
    headroom = snap.get("cache_headroom_gb")
    if (hours is not None and headroom is not None and not snap.get("uncounted")
            and free - headroom >= DISK_FLOOR_GB + margin_gb):
        hours = None
    if free < DISK_CRIT_GB:
        on["disk-crit"] = f"only {free:.1f} GB of the disk is free"
    if free < DISK_LOW_GB + margin_gb or (hours is not None and hours < within_h):
        why = f"{free:.1f} GB free"
        if hours is not None:
            why += f", falling {rate:.1f} GB an hour: full in about {hours:.0f} hours"
        on["disk"] = why
    # Swap that only holds pages set aside earlier costs nothing; swap MOVING
    # while memory is short is what slows the site (the morning report's rule).
    # Once on, its lines move out so a reading on a line can't flip it.
    mem_held = "memory" in already_on
    margin_mb = MEM_CLEAR_MARGIN_MB if mem_held else 0
    swapping = snap.get("swap_rate")
    swap_line = SWAP_ACTIVE_PAGES_S / 2 if mem_held else SWAP_ACTIVE_PAGES_S
    avail = snap["mem_available_mb"]
    if avail < MEM_MIN_MB + margin_mb or (swapping is not None and swapping > swap_line
                                          and avail < SWAP_SHORT_MEM_MB + margin_mb):
        moving = "" if swapping is None else f", {swapping:g} pages a second moving"
        on["memory"] = (f"{avail} MB of memory available, "
                        f"{snap['swap_used_mb']} MB of swap in use{moving}")
    # One alarm per unit, so a second unit failing while the first recovers is
    # its own email and a clear names the unit that recovered.
    for u in sorted(snap["failed_units"]):
        on[unit_key(u)] = f"{u} failed"
    for u in sorted(snap.get("stopped_units") or []):
        on.setdefault(unit_key(u), f"{u} stopped after an error")
    now = snap.get("now")
    for u, last in (snap.get("units_seen") or {}).items():
        key = unit_key(u)
        if key in on or key not in already_on or now is None or now - last >= UNIT_CLEAR_S:
            continue
        prior = already_on.get(key, {}) if isinstance(already_on, dict) else {}
        on[key] = (prior.get("reason") if isinstance(prior, dict) else None) or f"{u} failed"
    for key, age, limit, what in (
            ("sampler", snap.get("sampler_age_s"), SAMPLER_STALE_S, "the health sampler"),
            ("page-cache", snap.get("prune_age_s"), PRUNE_STALE_S, "the page-cache cap"),
            ("backup", snap.get("backup_age_s"), BACKUP_STALE_S, "the nightly backup"),
            ("journal", snap.get("journal_age_s"), JOURNAL_STALE_S, "a write to the journal on disk")):
        if age is None or age > limit:
            when = "never" if age is None else f"{age / 3600:.1f} hours ago"
            on[key] = f"{what} last finished {when}"
    if snap.get("uncounted"):
        on["page-cache-blind"] = ("Next holds pages the page-cache cap doesn't count: "
                                  + "; ".join(snap["uncounted"]))
    return on


def unit_key(unit: str) -> str:
    """The alarm key for one systemd unit: "unit:" and its name without ".service"."""
    return "unit:" + unit.removesuffix(".service")


# Each alarm's kind in the routing list (scripts/data/alert_routes.json); a unit's depends on what it is.
ROUTE_OF = {
    "disk": "alarm.disk", "disk-crit": "alarm.disk-critical", "memory": "alarm.memory", "backup": "alarm.backup",
    "sampler": "alarm.sampler", "page-cache": "alarm.page-cache", "page-cache-blind": "alarm.page-cache-blind",
    "journal": "alarm.journal",
}


def route_of(key: str, info: dict[str, dict], runs: dict[str, dict]) -> str:
    """The routing list's kind for one alarm. A timed job is alarm.job-once until two of its runs in a row have
    failed, then alarm.job-twice; any other unit is a service (alarm.service), whose type systemd may not report."""
    if not key.startswith("unit:"):
        return ROUTE_OF[key]
    unit = key[5:] + ".service"
    if (info.get(unit) or {}).get("type") == "oneshot":
        return "alarm.job-twice" if (runs.get(unit) or {}).get("fails", 0) >= JOB_FAILS_TO_PUSH else "alarm.job-once"
    return "alarm.service"


def units_seen(prev: dict | None, snap: dict, now: float) -> dict[str, float]:
    """When each of our units was last seen failed or stopped after an error,
    kept for UNIT_CLEAR_S (evaluate holds an alarm that long after a restart)."""
    seen = {u: t for u, t in (prev or {}).items() if now - t < UNIT_CLEAR_S}
    for u in [*snap.get("failed_units", []), *(snap.get("stopped_units") or [])]:
        seen[u] = now
    return seen


def cache_headroom(report: dict) -> float | None:
    """GB the page caches may still grow before the cap stops them, or None if unreadable."""
    total = 0.0
    for r in report.get("releases", []):
        budget, gb = r.get("budgetGB"), r.get("gb")
        if not isinstance(budget, (int, float)) or not isinstance(gb, (int, float)):
            return None
        total += max(0.0, budget - gb)
    return total


def uncounted_releases(report: dict) -> list[str]:
    """Releases holding UNCOUNTED_GB more in .next/server than the cap counted."""
    out = []
    for r in report.get("releases", []):
        server, counted = r.get("serverGB"), r.get("gb")
        if isinstance(server, (int, float)) and isinstance(counted, (int, float)) and server - counted > UNCOUNTED_GB:
            out.append(f"{r.get('release')} ({server:.0f} GB on disk, {counted:.0f} GB counted)")
    return out


def plan(on: dict[str, str], state: dict, now: float,
         runs: dict[str, str | None] | None = None,
         remind: dict[str, float | None] | None = None) -> tuple[list[tuple[str, str, str]], dict]:
    """Which emails to send: (key, kind, reason), kind start | still | clear.

    `runs`: for a timed job's alarm, the failed run it's on (its start, from job_runs). Its reminder goes only once a
    newer run has failed again, and still no sooner than its reminder gap: a daily job that failed once sent a start,
    three 6-hour reminders and a clear (Nov 22 2026), when nothing had changed between them.
    `remind`: an alarm's seconds between reminders, from its kind in the routing list, None for never; REMIND_S for an
    alarm not named.
    """
    runs = runs or {}
    remind = remind or {}
    alarms = dict(state.get("alarms", {}))
    out: list[tuple[str, str, str]] = []
    for key, reason in on.items():
        a = alarms.get(key)
        run = {"run": runs[key]} if key in runs else {}
        gap = remind.get(key, REMIND_S)
        if a is None:
            out.append((key, "start", reason))
            alarms[key] = {"since": now, "mailed": now, "reason": reason, **run}
        elif (gap is not None and now - a.get("mailed", 0) >= gap
              and (key not in runs or runs[key] != a.get("run"))):
            out.append((key, "still", reason))
            alarms[key] = {**a, "mailed": now, "reason": reason, **run}
        else:
            alarms[key] = {**a, "reason": reason}
    for key in list(alarms):
        if key not in on:
            out.append((key, "clear", alarms[key].get("reason", "")))
            del alarms[key]
    return out, {**state, "alarms": alarms}


def email_day(now: float) -> str:
    """The day the email cap counts in: Eastern, the day the owner reads in."""
    return datetime.fromtimestamp(now, ET).strftime("%Y-%m-%d")


def under_cap(state: dict, now: float) -> bool:
    day = email_day(now)
    return state.get("emails", {}).get(day, 0) < EMAILS_PER_DAY


def count_email(state: dict, now: float) -> dict:
    day = email_day(now)
    sent = {d: n for d, n in state.get("emails", {}).items() if d >= day}
    sent[day] = sent.get(day, 0) + 1
    return {**state, "emails": sent}


def unit_info(show: str) -> dict[str, dict]:
    """Each unit's state, result, type and last start, from `systemctl show` with
    -p Id -p ActiveState -p Result -p Type -p ExecMainStartTimestampMonotonic."""
    out = {}
    for block in show.split("\n\n"):
        f = dict(ln.split("=", 1) for ln in block.splitlines() if "=" in ln)
        if f.get("Id"):
            out[f["Id"]] = {"state": f.get("ActiveState"), "result": f.get("Result"),
                            "type": f.get("Type"), "start": f.get("ExecMainStartTimestampMonotonic")}
    return out


def job_runs(prev: dict | None, info: dict[str, dict]) -> dict[str, dict]:
    """How many runs in a row each failed timed job has failed. A run that ends well drops the job,
    so a failure, a success and a failure count as one; a job running now keeps its count."""
    out = {}
    for unit, i in info.items():
        if i.get("type") != "oneshot":
            continue
        before = (prev or {}).get(unit)
        if i.get("state") == "failed":
            if before and before.get("start") == i.get("start"):
                out[unit] = before
            else:
                out[unit] = {"start": i.get("start"), "fails": (before or {}).get("fails", 0) + 1}
        elif i.get("state") == "activating" and before:
            out[unit] = before
    return out


# Each kind's push before the routing list, kept for a list that can't be read: a service systemd has given up
# restarting is urgent, a job's single failure doesn't push, the rest are high.
LEVEL_WITHOUT_LIST = {"alarm.service": "urgent", "alarm.job-once": None}


def push_level(key: str, info: dict[str, dict], runs: dict[str, dict]) -> str | None:
    """urgent, high, or None (no push) for one alarm that is on: its kind's level in the routing list."""
    rid = route_of(key, info, runs)
    if not ROUTES.ok:
        return LEVEL_WITHOUT_LIST.get(rid, "high")
    return ROUTES.level(rid)


def mailable(on: dict[str, str], routes: dict[str, str], state: dict) -> dict[str, str]:
    """The alarms the email deals with: each whose kind is sent at once, and each already emailed, so its clear still
    goes. A kind the routing list leaves to the morning report or the admin page is kept only in `events`."""
    sent = state.get("alarms", {})
    return {k: r for k, r in on.items() if ROUTES.loud(routes[k]) or k in sent}


EVENTS_KEEP_S = 24 * 3600
EVENTS_MAX = 60


def record_events(events: list[dict] | None, on: dict[str, str], routes: dict[str, str],
                  runs: dict[str, str | None], now: float) -> list[dict]:
    """A day of alarm starts, each with its kind, which the health sampler copies into the server's report: the
    morning report lists from here what the routing list kept out of the email (a job's one failed run). A timed job
    starts one event per failed run; anything else, one each time it comes on. `over` is when it went off."""
    kept = [dict(e) for e in (events or []) if now - float(e.get("at") or 0) < EVENTS_KEEP_S]
    for e in kept:
        if "over" not in e and (e.get("key") not in on or runs.get(e["key"]) != e.get("run")):
            e["over"] = now
    live = {(e["key"], e.get("run")) for e in kept if "over" not in e}
    for key, reason in on.items():
        # A job whose run has since passed is held on a while (UNIT_CLEAR_S): that's its event ending, not a new one.
        if routes[key] in ("alarm.job-once", "alarm.job-twice") and runs.get(key) is None:
            continue
        if (key, runs.get(key)) not in live:
            kept.append({"at": now, "key": key, "route": routes[key], "reason": reason[:200], "run": runs.get(key)})
    return kept[-EVENTS_MAX:]


# A journal line that says why a job failed: its own verdict words, a Python error's last line, or a GitHub-style
# "::error::" annotation, which the ingests use for a refused source (Nov 24 2026: "Refused: the sheet's columns changed").
FAILURE_WORDS = re.compile(r"\bFAIL|BROKEN|\bfailed\b|\b\w*Error\b|::error::|\bRefused\b")
# The run's own bookkeeping ("recorded failed for x.py (verified)") repeats that it failed, never why: last resort only.
BOOKKEEPING = re.compile(r"^recorded \w+ for \S+")
# systemd's own lines about the unit ("x.service: Failed with result 'exit-code'.") say only that it failed.
SYSTEMD_LINE = re.compile(r"^(\S+\.(service|timer): |Failed to start |Starting |Started |Finished |Stopped )")
WHY_LINES = 4
TAIL_LINES = 3


def failure_lines(journal: str) -> list[str]:
    """Why a unit failed, from `journalctl -u <unit> -n 40 -o cat`: its last few FAIL, BROKEN, failed or error lines,
    or its last few lines when none says so. systemd's own lines are left out. Pure, for the test."""
    own = [ln.strip() for ln in journal.splitlines() if ln.strip() and not SYSTEMD_LINE.match(ln.strip())]
    shown = lambda ln: ln.removeprefix("::error::").strip()[:240]  # noqa: E731
    hits = [shown(ln) for ln in own if FAILURE_WORDS.search(ln)]
    telling = [ln for ln in hits if not BOOKKEEPING.match(ln)]
    picked = telling or hits
    return picked[-WHY_LINES:] if picked else [shown(ln) for ln in own][-TAIL_LINES:]


def todo_of(key: str) -> str:
    if key.startswith("unit:"):
        u = key[5:]
        return f"ssh permtracker, then journalctl -u {u} -n 50 to see why; systemctl restart {u} once fixed."
    return TODO.get(key, "Read the email.")


def phone_plan(on: dict[str, str], alarms: dict, pushed: dict, levels: dict[str, str | None],
               ) -> list[tuple[str, str, str]]:
    """Which pushes are due: (key, kind, level), kind start | clear. An alarm pushes once, when it first has a level,
    and clears only if it was pushed."""
    due = [(k, "start", levels[k]) for k in on if levels.get(k) and k not in pushed]
    due += [(k, "clear", "clear") for k in pushed if k not in on]
    return due


def push_words(key: str, kind: str, reason: str, since: float) -> tuple[str, str]:
    """The push's title and message, from phone_push's one template."""
    if kind == "clear":
        return "PERM Tracker server: fine again", phone_push.cleared(cleared_of(key)[0].upper() + cleared_of(key)[1:],
                                                                     since)
    what = title_of(key)
    return (f"PERM Tracker server: {what}",
            phone_push.started(f"{what[0].upper() + what[1:]}: {reason}.", since, todo_of(key)))


def pushes_left(state: dict, now: float) -> int:
    return PUSHES_PER_DAY - state.get("pushes", {}).get(email_day(now), 0)


def count_push(state: dict, now: float) -> dict:
    day = email_day(now)
    sent = {d: n for d, n in state.get("pushes", {}).items() if d >= day}
    sent[day] = sent.get(day, 0) + 1
    return {**state, "pushes": sent}


def send_pushes(state: dict, on: dict[str, str], levels: dict[str, str | None], now: float,
                pusher=None) -> tuple[dict, list[str]]:
    """Push what's due and record it; a failed or capped push stays due for the next run. Returns the new state and
    what was pushed, for the log line. `pusher` stands in for phone_push.push in tests."""
    pusher = pusher or (phone_push.push if phone_push else None)
    pushed = dict(state.get("phone", {}))
    alarms = state.get("alarms", {})
    done = []
    for key, kind, level in phone_plan(on, alarms, pushed, levels):
        if level != "urgent" and pushes_left(state, now) <= 0:
            continue
        since = (alarms.get(key) or pushed.get(key) or {}).get("since", now)
        reason = on.get(key) or (alarms.get(key) or {}).get("reason", "")
        if pusher is None:
            ok, why = False, "lib/phone_push.py isn't installed"
        elif DRY_RUN:
            print("would push ({}): {} / {}".format(level, *push_words(key, kind, reason, since)))
            ok, why = True, ""
        else:
            ok, why = pusher(*push_words(key, kind, reason, since), level)
        if not ok:
            state = {**state, "push_failing": state.get("push_failing") or {"since": now, "why": why}}
            print(f"push not sent ({why}); next run tries again")
            continue
        state = count_push({**state, "push_failing": None}, now)
        if kind == "clear":
            pushed.pop(key, None)
        else:
            pushed[key] = {"since": since, "level": level}
        done.append(f"{key} {kind}")
    return {**state, "phone": pushed}, done


# --------------------------------------------------------------------------
# Reading the machine
# --------------------------------------------------------------------------

def age_of(path: pathlib.Path, now: float) -> float | None:
    try:
        return now - path.stat().st_mtime
    except OSError:
        return None


def stopped_after_error(show: str) -> list[str]:
    """Services switched on yet stopped after an error, from `systemctl show
    -p Id -p ActiveState -p Result -p UnitFileState`. A unit that crashes into
    systemd's start limit is left "inactive", which `systemctl --failed` never
    lists (PCP's pmlogger, Oct 10 2026). Same rule as permtracker-health's."""
    out = []
    for block in show.split("\n\n"):
        f = dict(ln.split("=", 1) for ln in block.splitlines() if "=" in ln)
        if (f.get("ActiveState") == "inactive" and f.get("Result", "success") != "success"
                and f.get("UnitFileState", "").startswith("enabled")):
            out.append(f["Id"])
    return sorted(out)


def snapshot(now: float) -> dict:
    disk = shutil.disk_usage("/")
    mem = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0])
    failed = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain"],
                            capture_output=True, text=True).stdout.splitlines()
    units = [ln.split()[0] for ln in failed if ln.strip()]
    ours = subprocess.run(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--plain",
                           *(f"{u}*" for u in OUR_UNITS)], capture_output=True, text=True).stdout.splitlines()
    names = [ln.split()[0] for ln in ours if ln.strip()]
    show = subprocess.run(
        ["systemctl", "show", "-p", "Id", "-p", "ActiveState", "-p", "Result", "-p", "UnitFileState",
         "-p", "Type", "-p", "ExecMainStartTimestampMonotonic", *names],
        capture_output=True, text=True).stdout if names else ""
    stopped = stopped_after_error(show)
    prune_age = None
    uncounted: list[str] = []
    headroom = None
    try:
        report = json.loads((APP / "health" / "prune.json").read_text())
        prune_age = now - report["at"]
        uncounted = uncounted_releases(report)
        headroom = cache_headroom(report) if prune_age <= PRUNE_STALE_S else None
    except (OSError, ValueError, KeyError, TypeError):
        pass
    swapped = None
    try:
        swapped = sum(int(ln.split()[1]) for ln in open("/proc/vmstat")
                      if ln.startswith(("pswpin ", "pswpout ")))
    except (OSError, ValueError, IndexError):
        pass
    return {
        "swap_pages": swapped,
        "disk_free_gb": disk.free / GB,
        "mem_available_mb": mem.get("MemAvailable", 0) // 1024,
        "swap_used_mb": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) // 1024,
        "failed_units": [u for u in units if u.startswith(OUR_UNITS)],
        "stopped_units": [u for u in stopped if u.startswith(OUR_UNITS)],
        "unit_info": {u: i for u, i in unit_info(show).items() if u.startswith(OUR_UNITS)},
        "sampler_age_s": age_of(APP / "health" / "samples.jsonl", now),
        "prune_age_s": prune_age,
        "uncounted": uncounted,
        "cache_headroom_gb": headroom,
        "backup_age_s": age_of(APP / "backups" / "LAST_OK", now),
        "journal_age_s": journal_age(now),
    }


def journal_age(now: float) -> float | None:
    """Seconds since journald last wrote its system journal on disk; None when there is none."""
    ages = [a for a in (age_of(f, now) for f in JOURNAL.glob("*/system.journal")) if a is not None]
    return min(ages) if ages else None


# --------------------------------------------------------------------------
# Fixing what can be fixed
# --------------------------------------------------------------------------

def live_dirs() -> set[str]:
    app = APP / "app"
    try:
        slot = (app / "active").read_text().strip()
    except OSError:
        return set()
    return {os.path.realpath(app / "slots" / s) for s in (slot, slot + "2")
            if (app / "slots" / s).exists()}


def drop_route_caches() -> list[str]:
    """Delete the route cache of every release the live slot does not run from."""
    keep = live_dirs()
    if not keep:
        return []          # without knowing the live slot, delete nothing
    done = []
    for rel in sorted((APP / "app" / "releases").iterdir()):
        if os.path.realpath(rel) in keep:
            continue
        cache = rel / ".next" / "server" / "route-cache"
        if cache.is_dir():
            if not DRY_RUN:
                shutil.rmtree(cache, ignore_errors=True)
            done.append(rel.name)
    return done


def start_prune() -> None:
    if not DRY_RUN:
        subprocess.run(["systemctl", "start", "--no-block", "permtracker-prune.service"],
                       capture_output=True)


def heal(on: dict[str, str]) -> list[str]:
    actions = []
    if "journal" in on:
        r = subprocess.run(["journalctl", "--flush"], capture_output=True, text=True)
        actions.append("asked journald to move its log to disk and write there again"
                       + ("" if r.returncode == 0 else f" (it answered {r.returncode})"))
    if "disk-crit" in on:
        dropped = drop_route_caches()
        if dropped:
            actions.append("deleted the page cache of the releases not serving the site: "
                           + ", ".join(dropped))
    if "disk" in on or "disk-crit" in on:
        start_prune()
        actions.append("started the page-cache cap (it runs tight budgets under 20 GB free)")
    return actions


# --------------------------------------------------------------------------
# Telling the owner
# --------------------------------------------------------------------------

TITLES = {
    "disk": "the disk is filling", "disk-crit": "the disk is nearly full",
    "memory": "memory is low",
    "sampler": "the health sampler stopped", "page-cache": "the page-cache cap stopped",
    "backup": "the nightly backup is late",
    "journal": "the server's log isn't reaching the disk",
    "page-cache-blind": "the page-cache cap can't see some pages",
}
# What each alarm clearing means, said as the good news. The Oct 10 2026 clear
# was titled "back to normal (the disk is filling)" and repeated the old
# "full in about 12 hours" under CLEARED, which read as the disk still filling.
CLEARED = {
    "disk": "the disk is no longer on course to fill", "disk-crit": "the disk has room again",
    "memory": "memory has recovered",
    "sampler": "the health sampler is running again", "page-cache": "the page-cache cap is running again",
    "backup": "the nightly backup has run",
    "journal": "the server's log is reaching the disk again",
    "page-cache-blind": "the page-cache cap can see every page again",
}


def title_of(key: str) -> str:
    if key.startswith("unit:"):
        return f"{key[5:]} failed"
    return TITLES.get(key, key)


def cleared_of(key: str) -> str:
    if key.startswith("unit:"):
        return f"{key[5:]} has run cleanly for {UNIT_CLEAR_S // 60} minutes"
    return CLEARED.get(key, key)


def read_env(path: pathlib.Path) -> dict:
    out = {}
    try:
        for ln in path.read_text().splitlines():
            if "=" in ln and not ln.lstrip().startswith("#"):
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def via_worker(subject: str, text: str) -> bool:
    """Send through the mail Worker. False when it isn't set up or didn't take it."""
    cfg = read_env(OWNER_MAIL)
    url, key = cfg.get("OWNER_MAIL_URL"), cfg.get("OWNER_MAIL_KEY")
    if not url or not key:
        return False
    req = urllib.request.Request(
        url, method="POST", data=json.dumps({"subject": subject, "text": text}).encode(),
        headers={"x-owner-mail-key": key, "Content-Type": "application/json", "User-Agent": USER_AGENT})
    try:
        urllib.request.urlopen(req, timeout=15).read()
        return True
    except (urllib.error.URLError, OSError) as exc:
        print(f"mail Worker failed, using Resend: {exc}")
        return False


def send(subject: str, text: str) -> bool:
    if DRY_RUN:
        print(f"would email: {subject}\n{text}\n")
        return True
    if via_worker(subject, text):
        return True
    key = read_env(APP_ENV).get("RESEND_API_KEY")
    to = read_env(CONFIG).get("ALERT_TO")
    if not key or not to:
        print("no RESEND_API_KEY or ALERT_TO; cannot email")
        return False
    req = urllib.request.Request(
        "https://api.resend.com/emails", method="POST",
        data=json.dumps({"from": "PERM Tracker <notifications@permtracker.app>", "to": [to],
                         "subject": subject, "text": text}).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json",
                 "User-Agent": USER_AGENT})
    try:
        urllib.request.urlopen(req, timeout=20).read()
        return True
    except (urllib.error.URLError, OSError) as exc:
        print(f"email failed: {exc}")
        return False


DISK_KEYS = ("disk", "disk-crit")


def compose(mail: list[tuple[str, str, str]], snap: dict, rate: float | None,
            actions: list[str], now: float, push_failing: dict | None = None,
            why: dict[str, list[str]] | None = None) -> tuple[str, str]:
    """The email. `why`: a unit alarm's key to the failure lines from its journal (failure_lines)."""
    why = why or {}
    stamp = datetime.fromtimestamp(now, ET).strftime("%A %b %-d, %-I:%M %p %Z")
    starts = [m for m in mail if m[1] != "clear"]
    if starts:
        subject = "PERM Tracker server: " + "; ".join(title_of(k) for k, _, _ in starts)
    else:
        subject = "PERM Tracker server: back to normal, " + "; ".join(cleared_of(k) for k, _, _ in mail)
    lines = [f"Checked {stamp}.", ""]
    for key, kind, reason in mail:
        if kind == "clear":
            lines.append(f"CLEARED: {cleared_of(key)}. (It had said: {reason}.)")
        else:
            word = {"start": "NEW", "still": "STILL"}[kind]
            lines.append(f"{word}: {title_of(key)}. {reason}.")
            if why.get(key):
                lines += ["Why, from its log:"] + [f"  {ln}" for ln in why[key]]
            lines.append(f"To do: {todo_of(key)}")
    if actions:
        lines += ["", "Done automatically:"] + [f"- {a}." for a in actions]
    keys = {k for k, _, _ in mail}
    # rate is GB an hour the disk is LOSING; say it in that direction.
    if rate is None:
        trend = ""
    elif rate >= 0:
        trend = f", falling {rate:.1f} GB an hour"
    else:
        trend = f", rising {-rate:.1f} GB an hour"
    # The disk and the memory only for their own alarms: on a failed job they were two lines of noise.
    if keys & set(DISK_KEYS) or "memory" in keys:
        lines.append("")
    if keys & set(DISK_KEYS):
        lines.append(f"Disk: {snap['disk_free_gb']:.1f} GB free{trend}.")
    if "memory" in keys:
        lines.append(f"Memory: {snap['mem_available_mb']} MB available, {snap['swap_used_mb']} MB swap.")
    headroom = snap.get("cache_headroom_gb")
    if (keys & set(DISK_KEYS) and headroom is not None and rate is not None and rate > 0
            and not snap.get("uncounted")):
        floor = snap["disk_free_gb"] - headroom
        lines.append(f"The page caches may grow {headroom:.1f} GB more before their cap stops them, "
                     f"which would leave about {floor:.0f} GB free.")
    if push_failing:
        lines.append(f"Pushes to your phone have failed since "
                     f"{datetime.fromtimestamp(push_failing['since'], ET).strftime('%A %b %-d, %-I:%M %p %Z')}"
                     f" ({push_failing.get('why', 'no reason given')}); each run tries again.")
    if not ROUTES.ok:
        lines.append(f"The routing list couldn't be used ({ROUTES.problem}), so every alarm goes by email and phone "
                     "until it can.")
    lines += ["", "This alarm runs every 5 minutes on the server (permtracker-alarm); it emails again "
              "every 6 hours while something lasts (a timed job's only once a newer run has failed again), and "
              "once when it clears. It pushes to your phone once when something starts and once when it clears. "
              "Where each alarm goes is set in the routing list, scripts/data/alert_routes.json: a timed job's "
              "first failed run waits for the morning report."]
    return subject, "\n".join(lines)


def read_journal(unit: str) -> str:
    """The unit's last 40 journal messages, or "" when they can't be read."""
    try:
        return subprocess.run(["journalctl", "-u", unit, "-n", "40", "-o", "cat", "--no-pager"],
                              capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def main() -> int:
    now = time.time()
    RUN.mkdir(parents=True, exist_ok=True)
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    snap = snapshot(now)
    points = [p for p in state.get("disk", []) if now - p[0] <= HISTORY_S]
    points.append([now, round(snap["disk_free_gb"], 2)])
    state["disk"] = points
    rate = rate_gb_per_hour(points, now)
    # The one alarm for every unit (before Oct 31 2026) gives way to one per unit
    # without a misleading "no job or service is down" email.
    state.setdefault("alarms", {}).pop("units", None)
    state["units_seen"] = units_seen(state.get("units_seen"), snap, now)
    snap["units_seen"], snap["now"] = state["units_seen"], now
    snap["swap_rate"] = swap_rate(state.get("swap"), now, snap.get("swap_pages"))
    if snap.get("swap_pages") is not None:
        state["swap"] = [now, snap["swap_pages"]]
    on = evaluate(snap, rate, state.get("alarms", {}))
    actions = heal(on)
    info = snap.get("unit_info") or {}
    state["job_runs"] = job_runs(state.get("job_runs"), info)
    levels = {k: push_level(k, info, state["job_runs"]) for k in on}
    runs = {unit_key(u): r.get("start") for u, r in state["job_runs"].items()}
    # Each alarm's kind in the routing list decides whether the email deals with it and how often it reminds.
    routes = {k: route_of(k, info, state["job_runs"]) for k in on}
    remind = {k: ROUTES.remind_s(routes[k]) for k in on}
    mail, planned = plan(mailable(on, routes, state), state, now, runs, remind)
    # Why each failed unit failed, from its own log, for the email that names it.
    why = {k: failure_lines(read_journal(k[5:] + ".service")) for k, kind, _ in mail
           if k.startswith("unit:") and kind != "clear"}
    undelivered = capped = False
    if not mail:
        state = planned
    elif under_cap(state, now):
        if send(*compose(mail, snap, rate, actions, now, state.get("push_failing"), why)):
            state = count_email(planned, now)
        else:
            # Nothing is marked sent, so the next run (5 minutes) tries again,
            # and this run exits 1: a missing key or a refusal had only printed
            # to the journal, so the unit never showed as failed and nothing
            # noticed that the last-line alarm couldn't email anyone.
            undelivered = True
    else:
        # Over the day's cap: nothing is marked sent, so what's due goes in the
        # first email after midnight Eastern if it still holds.
        capped = True
    # The phone, after the email: a push never holds the email up.
    state, pushed = send_pushes(state, on, levels, now)
    # Every start, sent or not, for the morning report (the health sampler copies it into the server's report).
    state["events"] = record_events(state.get("events"), on, routes, runs, now)
    if not DRY_RUN:
        STATE.write_text(json.dumps(state))
    print(f"free {snap['disk_free_gb']:.1f} GB, rate "
          f"{'n/a' if rate is None else f'{rate:+.2f} GB/h'}, alarms {sorted(on) or 'none'}"
          + (f", emailed {[(k, kind) for k, kind, _ in mail]}" if mail and not (undelivered or capped) else "")
          + (f", over today's {EMAILS_PER_DAY}-email cap, not sent: {[(k, kind) for k, kind, _ in mail]}"
             if capped else "")
          + (", an email was due and could NOT be sent" if undelivered else "")
          + (f", pushed {pushed}" if pushed else ""))
    return 1 if undelivered else 0


if __name__ == "__main__":
    sys.exit(main())
