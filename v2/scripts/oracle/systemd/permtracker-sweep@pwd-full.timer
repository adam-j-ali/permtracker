[Unit]
Description=Schedule for permtracker-sweep@pwd-full
# Every wage request, weekly. Moved from GitHub's runners on Nov 7 2026 (the same clock the dispatch timer had).
[Timer]
OnCalendar=Sun *-*-* 06:40:00 America/New_York
Persistent=true
Unit=permtracker-sweep@pwd-full.service

[Install]
WantedBy=timers.target
