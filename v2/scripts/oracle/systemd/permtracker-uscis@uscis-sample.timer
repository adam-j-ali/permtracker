[Unit]
Description=Schedule for permtracker-uscis@uscis-sample
# The USCIS case-status sample, loaded nightly at 3:40 AM Eastern from the files that arrive each morning (Batch 3, Nov 25
# 2026): night only, since its writes and index builds stall page reads in the day. Persistent: a missed night loads at
# the next boot.
[Timer]
OnCalendar=*-*-* 03:40:00 America/New_York
Persistent=true
Unit=permtracker-uscis@uscis-sample.service

[Install]
WantedBy=timers.target
